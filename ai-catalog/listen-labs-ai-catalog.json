    {
      "identifier": "urn:air:listenlabs.com:server:mcp",
      "displayName": "Listen Labs MCP Server",
      "type": "application/mcp-server-card+json",
      "url": "https://listenlabs.ai/mcp",
      "description": "Remote MCP server for Listen Labs. Lets AI assistants create and edit studies, launch participant recruitment, browse and organize studies, search across research, and read transcripts and analysis reports. Stateless streamable HTTP transport with OAuth 2.0 automatic discovery.",
      "capabilities": [
        "list_studies",
        "search_across_studies",
        "get_study_state",
        "get_study_responses",
        "get_response",
        "get_study_analysis",
        "list_creatable_orgs",
        "create_study",
        "edit_study",
        "publish_study",
        "launch_study",
        "move_study",
        "manage_folder"
      ],
      "tags": [
        "mcp",
        "customer-research",
        "user-interviews",
        "insights"
      ],
      "representativeQueries": [
        "create a user interview study about onboarding friction",
        "launch recruitment for my pricing study",
        "what did participants say about checkout in my latest study",
        "summarize the analysis report for my concept test"
      ],
      "metadata": {
        "transport": "streamable-http",
        "authentication": "oauth2",
        "authorizationEndpoint": "https://listenlabs.ai/mcp/authorize",
        "alternateEndpoints": [
          "https://mcp.listenlabs.ai/mcp",
          "https://mcp.eu.listenlabs.com/mcp"
        ],
        "documentation": "https://docs.listenlabs.com/mcp-docs"
      },
      "trustManifest": {
        "identity": "https://listenlabs.ai/mcp",
        "identityType": "dns",
